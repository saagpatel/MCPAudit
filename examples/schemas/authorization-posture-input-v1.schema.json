{
  "$defs": {
    "ProducerAuthorizationMetadata": {
      "additionalProperties": false,
      "properties": {
        "authorization_endpoint": {
          "title": "Authorization Endpoint",
          "type": "string"
        },
        "client_id_metadata_document_supported": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "title": "Client Id Metadata Document Supported"
        },
        "code_challenge_methods_supported": {
          "items": {
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "title": "Code Challenge Methods Supported",
          "type": "array"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "registration_endpoint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Registration Endpoint"
        },
        "scopes_supported": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Scopes Supported",
          "type": "array"
        },
        "token_endpoint": {
          "title": "Token Endpoint",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "authorization_endpoint",
        "token_endpoint",
        "code_challenge_methods_supported",
        "scopes_supported",
        "client_id_metadata_document_supported",
        "registration_endpoint"
      ],
      "title": "ProducerAuthorizationMetadata",
      "type": "object"
    },
    "ProducerAuthorizationServer": {
      "additionalProperties": false,
      "properties": {
        "discovery": {
          "anyOf": [
            {
              "enum": [
                "rfc8414",
                "openid-connect",
                "rfc8414-path-insertion",
                "openid-connect-path-insertion",
                "openid-connect-path-append"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Discovery"
        },
        "issuer": {
          "title": "Issuer",
          "type": "string"
        },
        "metadata": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProducerAuthorizationMetadata"
            },
            {
              "type": "null"
            }
          ]
        },
        "metadata_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Metadata Url"
        },
        "reason_codes": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Reason Codes",
          "type": "array"
        },
        "state": {
          "enum": [
            "metadata-ready",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "issuer",
        "state",
        "metadata_url",
        "discovery",
        "metadata",
        "reason_codes"
      ],
      "title": "ProducerAuthorizationServer",
      "type": "object"
    },
    "ProducerBinding": {
      "additionalProperties": false,
      "properties": {
        "manifest_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Manifest Sha256",
          "type": "string"
        },
        "resource_url": {
          "title": "Resource Url",
          "type": "string"
        },
        "source_kind": {
          "const": "official-mcp-registry-export",
          "title": "Source Kind",
          "type": "string"
        },
        "stable_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/@:-]{0,255}$",
          "title": "Stable Id",
          "type": "string"
        }
      },
      "required": [
        "stable_id",
        "resource_url",
        "manifest_sha256",
        "source_kind"
      ],
      "title": "ProducerBinding",
      "type": "object"
    },
    "ProducerCapabilityBoundary": {
      "additionalProperties": false,
      "properties": {
        "credentials_supported": {
          "const": false,
          "title": "Credentials Supported",
          "type": "boolean"
        },
        "dns_addresses_pinned": {
          "const": true,
          "title": "Dns Addresses Pinned",
          "type": "boolean"
        },
        "mutation_capabilities": {
          "items": {
            "type": "string"
          },
          "maxItems": 0,
          "title": "Mutation Capabilities",
          "type": "array"
        },
        "network_methods": {
          "items": {
            "const": "GET",
            "type": "string"
          },
          "maxItems": 1,
          "minItems": 1,
          "title": "Network Methods",
          "type": "array"
        },
        "non_public_addresses_allowed": {
          "const": false,
          "title": "Non Public Addresses Allowed",
          "type": "boolean"
        },
        "proxy_environment_used": {
          "const": false,
          "title": "Proxy Environment Used",
          "type": "boolean"
        },
        "redirects_followed": {
          "const": false,
          "title": "Redirects Followed",
          "type": "boolean"
        }
      },
      "required": [
        "network_methods",
        "credentials_supported",
        "proxy_environment_used",
        "redirects_followed",
        "dns_addresses_pinned",
        "non_public_addresses_allowed",
        "mutation_capabilities"
      ],
      "title": "ProducerCapabilityBoundary",
      "type": "object"
    },
    "ProducerClaimCeiling": {
      "additionalProperties": false,
      "properties": {
        "authorization_proven": {
          "const": false,
          "title": "Authorization Proven",
          "type": "boolean"
        },
        "credentials_available": {
          "const": false,
          "title": "Credentials Available",
          "type": "boolean"
        },
        "runtime_security_proven": {
          "const": false,
          "title": "Runtime Security Proven",
          "type": "boolean"
        },
        "trust_grade_authority": {
          "const": false,
          "title": "Trust Grade Authority",
          "type": "boolean"
        }
      },
      "required": [
        "authorization_proven",
        "credentials_available",
        "trust_grade_authority",
        "runtime_security_proven"
      ],
      "title": "ProducerClaimCeiling",
      "type": "object"
    },
    "ProducerFetch": {
      "additionalProperties": false,
      "properties": {
        "body_bytes": {
          "anyOf": [
            {
              "maximum": 65536,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Bytes"
        },
        "body_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body Sha256"
        },
        "content_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Type"
        },
        "freshness": {
          "$ref": "#/$defs/ProducerFreshness"
        },
        "kind": {
          "pattern": "^[a-z0-9][a-z0-9:-]{0,127}$",
          "title": "Kind",
          "type": "string"
        },
        "reason_code": {
          "pattern": "^[a-z][a-z0-9_]{0,127}$",
          "title": "Reason Code",
          "type": "string"
        },
        "state": {
          "enum": [
            "unknown",
            "invalid",
            "validated"
          ],
          "title": "State",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "maximum": 599,
              "minimum": 100,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url",
        "freshness",
        "state",
        "reason_code"
      ],
      "title": "ProducerFetch",
      "type": "object"
    },
    "ProducerFreshness": {
      "additionalProperties": false,
      "properties": {
        "age_header_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Age Header Seconds"
        },
        "cache_control": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Cache Control"
        },
        "effective_age_seconds": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Effective Age Seconds"
        },
        "http_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Http Date"
        },
        "last_modified": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Modified"
        },
        "policy_freshness_seconds": {
          "anyOf": [
            {
              "maximum": 86400,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Policy Freshness Seconds"
        },
        "state": {
          "enum": [
            "current",
            "unknown"
          ],
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "state"
      ],
      "title": "ProducerFreshness",
      "type": "object"
    },
    "ProducerResourceMetadata": {
      "additionalProperties": false,
      "properties": {
        "authorization_servers": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Authorization Servers",
          "type": "array"
        },
        "discovery": {
          "enum": [
            "www-authenticate",
            "well-known-path",
            "well-known-root"
          ],
          "title": "Discovery",
          "type": "string"
        },
        "metadata_url": {
          "title": "Metadata Url",
          "type": "string"
        },
        "resource": {
          "title": "Resource",
          "type": "string"
        },
        "scopes_supported": {
          "items": {
            "type": "string"
          },
          "maxItems": 64,
          "title": "Scopes Supported",
          "type": "array"
        }
      },
      "required": [
        "resource",
        "authorization_servers",
        "scopes_supported",
        "metadata_url",
        "discovery"
      ],
      "title": "ProducerResourceMetadata",
      "type": "object"
    },
    "ProducerSpecification": {
      "additionalProperties": false,
      "properties": {
        "profile": {
          "const": "mcp-authorization-2025-11-25",
          "title": "Profile",
          "type": "string"
        },
        "references": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "profile",
        "references"
      ],
      "title": "ProducerSpecification",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "authorization_required": {
      "anyOf": [
        {
          "const": true,
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "title": "Authorization Required"
    },
    "authorization_servers": {
      "items": {
        "$ref": "#/$defs/ProducerAuthorizationServer"
      },
      "maxItems": 8,
      "title": "Authorization Servers",
      "type": "array"
    },
    "binding": {
      "$ref": "#/$defs/ProducerBinding"
    },
    "capability_boundary": {
      "$ref": "#/$defs/ProducerCapabilityBoundary"
    },
    "challenge_scopes": {
      "items": {
        "type": "string"
      },
      "maxItems": 64,
      "title": "Challenge Scopes",
      "type": "array"
    },
    "claim_ceiling": {
      "$ref": "#/$defs/ProducerClaimCeiling"
    },
    "contract_version": {
      "const": "1.0.0",
      "title": "Contract Version",
      "type": "string"
    },
    "fetches": {
      "items": {
        "$ref": "#/$defs/ProducerFetch"
      },
      "maxItems": 32,
      "title": "Fetches",
      "type": "array"
    },
    "observed_at": {
      "title": "Observed At",
      "type": "string"
    },
    "reason_codes": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Reason Codes",
      "type": "array"
    },
    "resource_metadata": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProducerResourceMetadata"
        },
        {
          "type": "null"
        }
      ]
    },
    "scan_eligibility": {
      "enum": [
        "policy-review-only",
        "blocked"
      ],
      "title": "Scan Eligibility",
      "type": "string"
    },
    "schema_version": {
      "const": "McpAuthorizationPostureV1",
      "title": "Schema Version",
      "type": "string"
    },
    "specification": {
      "$ref": "#/$defs/ProducerSpecification"
    },
    "state": {
      "enum": [
        "metadata-ready",
        "unknown"
      ],
      "title": "State",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "contract_version",
    "observed_at",
    "specification",
    "binding",
    "state",
    "scan_eligibility",
    "authorization_required",
    "challenge_scopes",
    "resource_metadata",
    "authorization_servers",
    "fetches",
    "reason_codes",
    "capability_boundary",
    "claim_ceiling"
  ],
  "title": "McpAuthorizationPostureV1",
  "type": "object"
}
