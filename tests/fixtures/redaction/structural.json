  {
    "id": "structural-argv-boundaries",
    "kind": "args",
    "source": ["--api\u200b-key", "plantedfirst plantedsecond,plantedthird&plantedfourth", "--password=plantedfirst\"plantedsecond'plantedthird", "--port", "8080"],
    "expected": ["--api\u200b-key", "<redacted>", "--password=<redacted>", "--port", "8080"],
    "forbidden": ["plantedfirst", "plantedsecond", "plantedthird", "plantedfourth"]
