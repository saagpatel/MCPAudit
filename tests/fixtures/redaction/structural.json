    "source": "--password \"fixture\\\"quote suffix-secret\"",
    "expected": "--password <redacted>",
    "forbidden": ["fixture", "suffix-secret"]
  },
  {
    "id": "escaped-single-quote-flag",
    "kind": "text",
    "source": "--token 'fixture\\'quote suffix-secret'",
    "expected": "--token <redacted>",
    "forbidden": ["fixture", "suffix-secret"]
  },
  {
    "id": "zero-width-bearer",
    "kind": "text",
