  {
    "id": "schema-property-and-key-collision",
    "kind": "schema",
    "source": {"type": "object", "properties": {"token=property-secret": {"type": "string"}, "token=other-secret": {"type": "integer"}}, "required": ["token=property-secret", "token=other-secret"]},
    "expected": {"type": "object", "properties": {"token=<redacted>": {"type": "string"}, "token=<redacted> [2]": {"type": "integer"}}, "required": ["token=<redacted>", "token=<redacted>"]},
    "forbidden": ["property-secret", "other-secret"]
  },
  {
    "id": "unicode-secret-schema-literals",
    "kind": "schema",
    "source": {"properties": {"pass\u200bword": {"type": "string", "default": "default-secret", "enum": ["enum-secret"], "examples": [{"token=example-key-secret": "example-secret"}], "const": "const-secret"}, "port": {"type": "integer", "default": 8080}}},
    "expected": {"properties": {"pass\u200bword": {"type": "string", "default": "<redacted>", "enum": ["<redacted>"], "examples": [{"token=<redacted>": "<redacted>"}], "const": "<redacted>"}, "port": {"type": "integer", "default": 8080}}},
    "forbidden": ["default-secret", "enum-secret", "example-key-secret", "example-secret", "const-secret"]
  },
  {
    "id": "nested-json-keys-and-secret-containers",
    "kind": "meta",
    "source": {"token=map-secret": {"value": "container-secret", "count": 2}, "items": [{"ghp_abcdefghijklmnopqrstuvwxyz012345": "ordinary"}]},
    "expected": {"token=<redacted>": {"value": "<redacted>", "count": 2}, "items": [{"<redacted>": "ordinary"}]},
    "forbidden": ["map-secret", "container-secret", "abcdefghijklmnopqrstuvwxyz012345"]
  },
  {
    "id": "header-map-with-opaque-value",
    "kind": "meta",
    "source": {"headers": {"X-Custom": "opaque-header-secret", "Authorization": "Bearer header-secret"}},
    "expected": {"headers": {"X-Custom": "<redacted>", "Authorization": "<redacted>"}},
    "forbidden": ["opaque-header-secret", "header-secret"]
  },
